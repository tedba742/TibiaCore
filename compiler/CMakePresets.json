{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 22, "patch": 0 },
  "configurePresets": [
    {
      "name": "default",
      "displayName": "Default (Debug)",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/default",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BUILD_TFS": true,
        "BUILD_TESTING": true
      }
    },
    {
      "name": "asan-ubsan",
      "displayName": "ASan+UBSan",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/asan",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BUILD_TFS": true,
        "BUILD_TESTING": true,
        "CMAKE_CXX_FLAGS": "-fsanitize=address,undefined -fno-omit-frame-pointer",
        "CMAKE_LINKER_FLAGS": "-fsanitize=address,undefined"
      }
    },
    {
      "name": "coverage",
      "displayName": "Coverage (gcov)",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/coverage",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BUILD_TFS": false,
        "BUILD_TESTING": true,
        "CMAKE_CXX_FLAGS": "--coverage",
        "CMAKE_EXE_LINKER_FLAGS": "--coverage"
      }
    },
    {
      "name": "tidy",
      "displayName": "Clang-Tidy (no build)",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/tidy",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "BUILD_TFS": false,
        "BUILD_TESTING": false,
        "CMAKE_EXPORT_COMPILE_COMMANDS": true
      }
    }
  ],
  "buildPresets": [
    {
      "name": "default-build",
      "configurePreset": "default",
      "jobs": 8
    },
    {
      "name": "asan-build",
      "configurePreset": "asan-ubsan",
      "jobs": 8
    },
    {
      "name": "coverage-build",
      "configurePreset": "coverage",
      "jobs": 8
    }
  ],
  "testPresets": [
    {
      "name": "default-test",
      "configurePreset": "default"
    },
    {
      "name": "asan-test",
      "configurePreset": "asan-ubsan"
    },
    {
      "name": "coverage-test",
      "configurePreset": "coverage"
    }
  ]
}
